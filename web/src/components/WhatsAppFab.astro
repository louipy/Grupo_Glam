---
// Botón flotante de WhatsApp (esquina inferior derecha). Monocromo negro (tinta de marca),
// logo minimalista de WhatsApp knockout. Presente en toda la web.
// Solo acompaña las secciones CENTRALES: el script lo oculta mientras el hero o el footer
// ocupan la zona inferior-derecha donde vive (ni hero ni footer, en todas las páginas).
const wa = 'https://wa.me/584122398253';
---
<a
  href={wa}
  target="_blank"
  rel="noopener"
  class="gg-fab"
  aria-label="Escríbenos por WhatsApp"
>
  <svg class="gg-fab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
  </svg>
</a>

<style>
  .gg-fab {
    position: fixed;
    /* Pegado más al borde derecho (dentro del gutter de la página) para no chocar con las
       imágenes de "Inmuebles destacados". */
    right: clamp(8px, 1vw, 14px);
    bottom: clamp(16px, 2.4vw, 32px);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(52px, 5vw, 60px);
    height: clamp(52px, 5vw, 60px);
    border-radius: 999px;
    background: var(--color-tinta);
    color: var(--color-papel);
    border: 1px solid rgba(246, 243, 236, .14);
    box-shadow: 0 10px 30px -12px rgba(11, 12, 14, .55);
    /* Oculto por defecto: el script lo revela solo en las secciones centrales (ni hero ni
       footer). transform reservado para hover/press (snappy); opacity/visibility para el
       fundido de entrada/salida al cruzar esas zonas. */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform .18s cubic-bezier(.23, 1, .32, 1),
                background .3s ease,
                box-shadow .3s ease,
                opacity .4s ease,
                visibility .4s;
  }
  .gg-fab.is-visible { opacity: 1; visibility: visible; pointer-events: auto; }
  .gg-fab-icon { width: 52%; height: 52%; display: block; }

  @media (hover: hover) and (pointer: fine) {
    .gg-fab:hover {
      transform: translateY(-2px) scale(1.05);
      background: #17181c;
      box-shadow: 0 16px 38px -14px rgba(11, 12, 14, .65);
    }
  }
  .gg-fab:active { transform: scale(.94); }
  .gg-fab:focus-visible { outline: 2px solid var(--color-bronce); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .gg-fab { transition: opacity .3s ease, visibility .3s, background .3s ease; }
    .gg-fab:hover, .gg-fab:active { transform: none; }
  }
</style>

<script>
  // El FAB solo acompaña las secciones CENTRALES: se oculta mientras el hero o el footer
  // ocupan la zona inferior-derecha donde vive. rAF-throttled (como el navbar), sin IO porque
  // el hero y el footer son sticky (su geometría quedaría "pegada" y engañaría a un observer).
  const fab = document.querySelector<HTMLElement>('.gg-fab');
  if (fab) {
    // Lámina de contenido que sube y cubre el hero (home / nosotros / detalle). Si no existe
    // (contacto, propiedades) no hay hero → el FAB puede verse desde el inicio del contenido.
    const lamina = document.querySelector<HTMLElement>('.scroll-over, .gg-scroll-over, .pd-scroll-over');
    // Envoltorio de contenido cuyo BORDE INFERIOR coincide con el inicio del footer (el footer
    // es sticky, así que no sirve medirlo a él directamente).
    const contentEnd = document.querySelector<HTMLElement>('main.gg-main, .gg');
    const ZONE = 120; // alto aprox. de la zona del FAB (botón + margen inferior) con holgura

    let ticking = false;
    const compute = () => {
      ticking = false;
      const vh = window.innerHeight;
      // Pasado el hero cuando la lámina ya cubre la zona del FAB (o cuando no hay hero).
      const pastHero = !lamina || lamina.getBoundingClientRect().top <= vh - ZONE;
      // El footer está a punto de entrar en la zona del FAB → ocultarlo con antelación.
      const footerNear = !!contentEnd && contentEnd.getBoundingClientRect().bottom <= vh - ZONE;
      fab.classList.toggle('is-visible', pastHero && !footerNear);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(compute); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    addEventListener('load', compute);
    compute();
  }
</script>
