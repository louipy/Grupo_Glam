---
// Footer global (mismo en todas las páginas, vía Base). Fondo #100E17 —el mismo de la
// sección "Quiénes somos" del homepage—. Contenido tomado de la última página del brochure:
// teléfono, sitio web, redes (@grupo_glam) y sede. Tipografía Montserrat + acento dorado
// #C9A46A (el del botón "Todas las propiedades"), coherente con las secciones oscuras.
const wa = 'https://wa.me/584122398253';
const year = new Date().getFullYear();

const nav = [
  { href: '/propiedades', label: 'Propiedades' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];
---
<footer class="ft">
  <div class="ft-wrap">
    <!-- Marca + contacto -->
    <div class="ft-grid">
      <div class="ft-brand">
        <img src="/brand/grupoglam-diamond.png" alt="Grupo Glam Inmobiliaria" width="384" height="410" class="ft-logo" />
        <p class="ft-brand-line">Acompañando las buenas decisiones de inversión inmobiliaria.</p>
      </div>

      <div class="ft-col">
        <p class="ft-label">Contacto</p>
        <a href="tel:+584122398253" class="ft-link">+58 (412) 239 8253</a>
        <a href={wa} target="_blank" rel="noopener" class="ft-link">WhatsApp</a>
      </div>

      <div class="ft-col">
        <p class="ft-label">Redes</p>
        <a href="https://instagram.com/grupo_glam" target="_blank" rel="noopener" class="ft-link">Instagram · @grupo_glam</a>
        <a href="https://tiktok.com/@grupo_glam" target="_blank" rel="noopener" class="ft-link">TikTok · @grupo_glam</a>
        <a href="https://www.grupoinmueblesglam.com" target="_blank" rel="noopener" class="ft-link">grupoinmueblesglam.com</a>
      </div>

      <div class="ft-col">
        <p class="ft-label">Explorar</p>
        {nav.map((i) => (
          <a href={i.href} class="ft-link">{i.label}</a>
        ))}
      </div>

      <div class="ft-col">
        <p class="ft-label">Sede</p>
        <span class="ft-sede">Caracas, Venezuela</span>
      </div>
    </div>

    <hr class="ft-rule" />

    <div class="ft-bottom">
      <span>© {year} Grupo Glam Inmobiliaria. Todos los derechos reservados.</span>
      <span class="ft-bottom-meta">Powered by Inxanity Studios</span>
    </div>
  </div>
</footer>

<style>
  /* Reveal por scroll: el footer queda fijo al fondo del viewport (sticky bottom) por DETRÁS
     de la lámina de contenido (.gg-main, z-index superior y opaca). Al llegar al final, la
     lámina se levanta y descubre el footer, como si siempre hubiera estado ahí. Puro layout
     (sin JS), compositado y fluido. */
  .ft {
    position: sticky;
    bottom: 0;
    z-index: 0;
    background: #100E17;
    color: var(--color-lino);
    font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;
  }
  /* Movimiento reducido: sin reveal; el footer fluye normal al final de la página. */
  @media (prefers-reduced-motion: reduce) {
    .ft { position: static; }
  }
  /* Mismos gutters laterales que el navbar (full-bleed, sin max-width): el contenido del
     footer se alinea con el logo/enlaces de la cabecera. Gutters asimétricos idénticos a
     .heronav-inner → izq. clamp(16px,3vw,32px) · der. clamp(20px,5vw,54px). No se altera el
     ancho de la página, solo los márgenes internos. */
  .ft-wrap {
    padding-inline: clamp(16px, 3vw, 32px) clamp(20px, 5vw, 54px);
    padding-block: clamp(56px, 8vw, 100px) clamp(28px, 3vw, 44px);
  }

  /* ---- Filetes ---- */
  .ft-rule {
    border: 0;
    height: 1px;
    background: color-mix(in srgb, #C9A46A 24%, transparent);
    margin: clamp(40px, 5vw, 72px) 0;
  }

  /* ---- Marca + columnas de contacto ---- */
  .ft-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(32px, 4vw, 56px);
  }
  @media (min-width: 560px) {
    .ft-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .ft-grid { grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr)); }
  }

  .ft-brand { max-width: 320px; }
  .ft-logo { width: 52px; height: auto; display: block; opacity: .95; }
  .ft-brand-line {
    margin: 18px 0 0;
    font-weight: 300;
    font-style: italic;
    font-size: 15px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-lino) 66%, transparent);
  }

  .ft-col { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .ft-label {
    margin: 0 0 2px;
    font-weight: 600;
    font-size: 11px;
    line-height: 1;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: #C9A46A;
  }
  .ft-link {
    color: color-mix(in srgb, var(--color-lino) 82%, transparent);
    text-decoration: none;
    font-weight: 400;
    font-size: 14px;
    letter-spacing: .01em;
    line-height: 1.3;
    box-shadow: inset 0 -1px 0 rgba(201, 164, 106, 0);
    transition: color .3s ease, box-shadow .3s ease;
  }
  .ft-link:hover {
    color: var(--color-lino);
    box-shadow: inset 0 -1px 0 #C9A46A;
  }
  .ft-link:focus-visible { outline: 2px solid #C9A46A; outline-offset: 3px; }
  .ft-sede {
    font-size: 14px;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-lino) 52%, transparent);
  }

  /* ---- Pie inferior ---- */
  .ft-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    justify-content: space-between;
    font-size: 12px;
    letter-spacing: .02em;
    color: color-mix(in srgb, var(--color-lino) 48%, transparent);
  }
  .ft-bottom-meta {
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    font-size: 11px;
  }
</style>
