    font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;
    animation: gg-fade .3s ease both;
  }
  .heronav-menu[hidden] { display: none; }
  .heronav-menu-close {
    position: absolute;
    top: 26px; right: clamp(20px, 5vw, 54px);
    width: 44px; height: 44px;
    background: transparent;
    border: 1px solid rgba(246, 243, 236, .28);
    border-radius: 2px;
    color: #F6F3EC;
    font-size: 20px; line-height: 1;
    cursor: pointer;
  }
  .heronav-menu-logo { width: 76px; height: auto; display: block; margin-bottom: 6px; }
  .heronav-menu-link {
    color: #F6F3EC;
    text-decoration: none;
    font-weight: 300;
    font-size: 1.9rem;
    letter-spacing: .02em;
  }
  .heronav-menu-wa {
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #100E17;
    text-decoration: none;
