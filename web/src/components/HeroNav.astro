---
// HeroNav · navbar de la home. Va FIJA por encima de todo (z-50) para que, cuando la
// lámina de contenido claro sube y cubre el hero, los iconos y el logo transicionen a un
// color oscuro que contrasta con ese fondo. El cambio se engancha al scroll con un
// view-timeline (--cover) declarado por el centinela dentro de .scroll-over (ver index.astro).
// Color/opacidad son transiciones válidas con prefers-reduced-motion (guía de Emil).
// `variant`: 'hero' → navbar fija/transparente sobre el hero (timelines de scroll: la
//               ENTRADA se revela por scroll junto al contenido del hero de la home).
//            'overlay' → igual que 'hero' (fija/transparente + color adaptativo por scroll),
//               pero SIEMPRE visible desde el inicio: para páginas con hero propio que no
//               tienen la cortina/timeline "--enter" de la home (p. ej. detalle de propiedad).
//            'solid' → navbar sticky con fondo oscuro para el RESTO de las páginas
//               (sin hero detrás). Mismo aspecto y enlaces; solo cambia el fondo y el pin.
//            'minimal' (prop aparte): SOLO en el detalle de propiedad. Oculta los enlaces
//               de la derecha (queda solo el logo blanco sobre la foto). Al cubrirse por la
//               lámina de contenido (is-on-light), el logo hace crossfade a un botón
//               hamburguesa que abre un DRAWER lateral con esos mismos enlaces.
interface Props { variant?: 'hero' | 'solid' | 'overlay'; minimal?: boolean; scrollReveal?: boolean }
const { variant = 'hero', minimal = false, scrollReveal = false } = Astro.props;

const links = [
  { label: 'Propiedades', href: '/propiedades' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contáctanos', href: '/contacto' },
];
// Enlaces del menú lateral (drawer): set ampliado y ÚNICO para toda la web. Incluye Inicio y,
// entre Nosotros y Contáctanos, los dos servicios. (La navbar horizontal conserva su set corto.)
const drawerLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Propiedades', href: '/propiedades' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Invierte desde el extranjero', href: '/invertir-desde-el-extranjero' },
  { label: 'Plan de referidos', href: '/referidos' },
  { label: 'Contáctanos', href: '/contacto' },
];
const wa = 'https://wa.me/584122398253';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class:list={['heronav', `heronav--${variant}`, minimal && 'heronav--minimal', scrollReveal && 'heronav--scroll-reveal']}>
  <div class="heronav-inner">
    {minimal ? (
      <div class="heronav-morph">
        <a href="/" class="heronav-logo gg-logo-link heronav-morph-logo" aria-label="Grupo Glam Inmobiliaria — inicio">
          <img class="heronav-logo-img heronav-logo-colored" src="/brand/grupoglam-diamond-white.png" alt="Grupo Glam" width="384" height="410" />
          <img class="heronav-logo-img heronav-logo-dark" src="/brand/grupoglam-diamond-dark.png" alt="" aria-hidden="true" width="384" height="410" />
        </a>
        <!-- Estado final (tras pasar la barra de specs): hamburguesa + logo negro a su derecha. -->
        <div class="heronav-morph-bar">
          <button id="gg-drawer-open" type="button" class="heronav-morph-burger" data-drawer-open aria-label="Abrir menú" aria-expanded="false" aria-controls="gg-drawer">
            <span></span><span></span><span></span>
          </button>
          <a href="/" class="heronav-morph-mark gg-logo-link" aria-label="Grupo Glam Inmobiliaria — inicio">
            <img class="heronav-morph-mark-img heronav-morph-mark--dark" src="/brand/grupoglam-diamond-dark.png" alt="Grupo Glam" width="384" height="410" />
            <img class="heronav-morph-mark-img heronav-morph-mark--white" src="/brand/grupoglam-diamond-white.png" alt="" aria-hidden="true" width="384" height="410" />
          </a>
        </div>
      </div>
    ) : (
      <Fragment>
        <div class="heronav-left">
          {(variant === 'hero' || scrollReveal) && (
            <button id="gg-hero-drawer-open" type="button" class="heronav-hero-burger" data-drawer-open aria-label="Abrir menú" aria-expanded="false" aria-controls="gg-drawer">
              <span></span><span></span><span></span>
            </button>
          )}
          <a href="/" class="heronav-logo gg-logo-link" aria-label="Grupo Glam Inmobiliaria — inicio">
            <img class="heronav-logo-img heronav-logo-colored" src="/brand/grupoglam-diamond-white.png" alt="Grupo Glam" width="384" height="410" />
            <img class="heronav-logo-img heronav-logo-dark" src="/brand/grupoglam-diamond-dark.png" alt="" aria-hidden="true" width="384" height="410" />
            <img class="heronav-logo-img heronav-logo-brand" src="/brand/grupoglam-diamond.png" alt="" aria-hidden="true" width="384" height="410" />
          </a>
        </div>

        <nav class="heronav-links" aria-label="Principal">
          {links.map((item) => (
            <a href={item.href} class:list={['heronav-link', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={wa} target="_blank" rel="noopener" class="heronav-wa">WhatsApp</a>
        </nav>

        <button type="button" class="heronav-burger" data-drawer-open aria-label="Abrir menú" aria-expanded="false" aria-controls="gg-drawer">
          <span></span><span></span><span></span>
        </button>
      </Fragment>
    )}
  </div>
</header>

{(
  <!-- Drawer lateral ÚNICO y compartido en TODA la web (home, detalle, Nosotros, Contáctanos,
       Propiedades…): mismo menú en todos lados, como el footer y la navbar. Se abre desde la
       izquierda con cualquier hamburguesa ([data-drawer-open]). En la home ocupa 30% en
       escritorio (--home); en móvil y el resto, un ancho usable. -->
  <div id="gg-drawer" class:list={['gg-drawer', !minimal && 'gg-drawer--home']} hidden>
    <div class="gg-drawer-scrim" data-drawer-close></div>
    <aside class="gg-drawer-panel" role="dialog" aria-modal="true" aria-label="Menú de navegación">
      <div class="gg-drawer-top">
        <img src="/brand/grupoglam-diamond-white.png" alt="Grupo Glam" width="384" height="410" class="gg-drawer-logo" />
        <button id="gg-drawer-close" type="button" class="gg-drawer-close" aria-label="Cerrar menú" data-drawer-close>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 2l14 14M16 2 2 16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <nav class="gg-drawer-nav" aria-label="Principal">
        {drawerLinks.map((item) => (
          <a href={item.href} class:list={['gg-drawer-link', isActive(item.href) && 'is-active']} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a href={wa} target="_blank" rel="noopener" class="gg-drawer-wa">WhatsApp</a>
    </aside>
  </div>
)}

<style>
  .heronav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    pointer-events: none;
    font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;
    /* Sin entrada temporal: el navbar se revela POR SCROLL junto al contenido del hero
       (ver @supports abajo). Base = visible como fallback sin soporte de scroll-timeline. */
  }
  .heronav a, .heronav button { pointer-events: auto; }

  /* El color del texto/iconos vive aquí y se hereda con currentColor.
     Estado inicial (sobre el hero): claro. Transiciona a tinta al cubrirse. */
  .heronav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    /* Padding izquierdo menor que el derecho: corre el logo un poco a la izquierda para que
       no choque con el contenido de abajo. El lado derecho (links/menú) se mantiene. */
    padding: clamp(20px, 3.4vw, 34px) clamp(20px, 5vw, 54px) clamp(20px, 3.4vw, 34px) clamp(16px, 3vw, 32px);
    color: #F6F3EC;
  }

  /* Logo: crossfade del diamante de marca (sobre el hero) al diamante oscuro (sobre el contenido) */
  .heronav-logo {
    position: relative;
    display: inline-flex;
    height: clamp(30px, 3.4vw, 38px);
    border-radius: 2px;
    outline-offset: 6px;
  }
  .heronav-logo-img { height: 100%; width: auto; display: block; }
  .heronav-logo-dark { position: absolute; inset: 0; opacity: 0; }
  /* Logo de marca original (diamante morado + diamante crema): SOLO cuando el navbar tiene
     fondo oscuro sólido (al cubrirlo la lámina clara, o en la variante sólida). Sobre el hero
     se conserva el diamante blanco. */
  .heronav-logo-brand { position: absolute; inset: 0; opacity: 0; }

  .heronav-links {
    display: flex;
    align-items: center;
    gap: clamp(24px, 3vw, 44px);
  }
  .heronav-link {
    color: currentColor;
    opacity: .82;
    text-decoration: none;
    font-weight: 500;
    font-size: 13px;
    line-height: 1;
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: 8px 1px;
    box-shadow: inset 0 -1px 0 rgba(201, 164, 106, 0);
    transition: opacity .35s ease, box-shadow .35s ease;
  }
  .heronav-link:hover { opacity: 1; box-shadow: inset 0 -1px 0 rgba(201, 164, 106, .9); }
  .heronav-link.is-active { opacity: 1; box-shadow: inset 0 -1px 0 rgba(201, 164, 106, .9); }

  .heronav-wa {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: currentColor;
    text-decoration: none;
    border: 1px solid rgba(201, 164, 106, .55);
    border-radius: 2px;
    padding: 11px 20px;
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: .16em;
    text-transform: uppercase;
    /* Sin `color` en la transición base: así el texto sigue AL INSTANTE al currentColor
       que la animación de scroll (--cover) cambia, igual que los .heronav-link. Antes,
       `color .35s` interceptaba cada cambio del scroll y lo perseguía con retraso,
       provocando el rebote/parpadeo claro. El `color` se transiciona solo en :hover. */
    transition: background .35s ease, border-color .35s ease, transform .16s ease;
  }
  .heronav-wa:hover {
    background: #C9A46A; color: #100E17; border-color: #C9A46A;
    transition: background .35s ease, color .35s ease, border-color .35s ease, transform .16s ease;
  }
  .heronav-wa:active { transform: scale(0.97); }

  /* Hamburguesa (3 líneas) UNIFICADA en toda la web: mismas líneas limpias que la de la home
     (sin recuadro ni línea dorada corta). Caja de 44px para buen área táctil; líneas de 30px. */
  .heronav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px; height: 44px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .heronav-burger span { display: block; width: 30px; height: 1.6px; background: currentColor; border-radius: 1px; }

  /* ---- Home (variante hero): hamburguesa + deslizamiento del logo al aparecer el fondo negro ----
     Sobre el hero: solo el logo en la esquina superior izquierda. Cuando la lámina clara cubre
     el navbar y este toma fondo oscuro (is-on-light), el logo se DESLIZA a la derecha y, en su
     hueco original, aparece una hamburguesa minimalista (3 líneas) que abre el drawer lateral. */
  .heronav-left {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .heronav-hero-burger {
    position: absolute;
    left: 0;
    top: 50%;
    display: none;                     /* solo escritorio; el móvil se trata aparte */
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 30px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-50%) translateX(-8px);
    transition: opacity .4s ease, transform .4s ease, visibility .4s;
  }
  .heronav-hero-burger span {
    display: block;
    height: 1.6px;
    width: 100%;
    background: currentColor;
    border-radius: 1px;
  }
  /* El logo de la home desliza (transform) — se suma al crossfade de color ya existente. */
  .heronav--hero .heronav-left .heronav-logo {
    transition: transform .45s cubic-bezier(.4, 0, .1, 1);
  }
  @media (min-width: 881px) {
    .heronav--hero .heronav-hero-burger { display: flex; }
    .heronav--hero.is-on-light .heronav-hero-burger {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(-50%) translateX(0);
    }
    .heronav--hero.is-on-light .heronav-left .heronav-logo {
      transform: translateX(clamp(42px, 4vw, 54px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .heronav--hero .heronav-left .heronav-logo { transition: none; }
    .heronav--hero .heronav-hero-burger { transition-property: opacity, visibility; }
  }

  /* ---- Variante SÓLIDA con revelado por scroll (página Propiedades) ----
     El navbar arranca como el sólido normal (logo a la izquierda + enlaces). Al scrollear,
     copia EXACTAMENTE el gesto de la home al cubrirse (sección "Inmuebles destacados"): el
     logo se desliza a la derecha y, en su hueco, aparece la hamburguesa que despliega el
     drawer lateral. Solo cambia de posición (transform) → compositado y fluido. */
  .heronav--scroll-reveal .heronav-left .heronav-logo {
    transition: transform .45s cubic-bezier(.4, 0, .1, 1);
  }
  @media (min-width: 881px) {
    .heronav--scroll-reveal .heronav-hero-burger { display: flex; }
    .heronav--scroll-reveal.is-scrolled .heronav-hero-burger {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(-50%) translateX(0);
    }
    .heronav--scroll-reveal.is-scrolled .heronav-left .heronav-logo {
      transform: translateX(clamp(42px, 4vw, 54px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .heronav--scroll-reveal .heronav-left .heronav-logo { transition: none; }
    .heronav--scroll-reveal .heronav-hero-burger { transition-property: opacity, visibility; }
  }

  .gg-logo-link:focus-visible,
  .heronav-link:focus-visible,
  .heronav-wa:focus-visible,
  .heronav-burger:focus-visible,
  .heronav-morph-burger:focus-visible,
  .heronav-hero-burger:focus-visible { outline: 2px solid #C9A46A; outline-offset: 4px; }

  /* Responsiva (breakpoint 880px, igual que el diseño original) */
  @media (max-width: 880px) {
    .heronav-links { display: none; }
    .heronav-burger { display: inline-flex; }
  }

  @keyframes gg-fade { from { opacity: 0 } to { opacity: 1 } }

  /* ---- Contraste adaptativo del navbar (lo conduce el script, vía elementFromPoint) ----
     El navbar es fijo y cruza bandas de distinto tono: hero oscuro, lámina clara de contenido,
     "Quiénes somos" oscuro, CTA oscuro. El script mide qué banda ([data-navtone]) queda bajo el
     centro del navbar y le añade .is-on-dark o .is-on-light. Así el logo y los enlaces SIEMPRE
     contrastan con lo que tienen debajo. Es un cambio de color (no de posición) → válido con
     prefers-reduced-motion; la transición lo suaviza. */
  /* El color adaptativo (script) aplica a 'hero' y 'overlay': ambas son navbars transparentes
     que cruzan bandas de distinto tono. */
  :is(.heronav--hero, .heronav--overlay) .heronav-inner { transition: color .4s ease; }
  :is(.heronav--hero, .heronav--overlay) .heronav-logo-colored,
  :is(.heronav--hero, .heronav--overlay) .heronav-logo-dark,
  :is(.heronav--hero, .heronav--overlay) .heronav-logo-brand { transition: opacity .4s ease; }

  /* OVERLAY + MINIMAL (detalle de propiedad): fondo claro debajo → tinta oscura (logo/burger).
     El navbar sigue transparente; solo cambia el color de los trazos para contrastar. */
  .heronav--overlay.heronav--minimal.is-on-light .heronav-inner { color: var(--color-tinta); }
  .heronav--overlay.heronav--minimal.is-on-light .heronav-logo-colored { opacity: 0; }
  .heronav--overlay.heronav--minimal.is-on-light .heronav-logo-dark { opacity: 1; }

  /* HERO (home) y OVERLAY sin minimal (Nosotros): al cubrir el navbar la lámina de contenido
     claro, este toma FONDO OSCURO y mantiene texto + logo claros → botones siempre legibles, sin
     chocar con el contenido. Sobre el hero (o bandas oscuras) queda transparente. Mismas
     proporciones delgadas y gutters laterales asimétricos (a ellos alinea el footer). */
  :is(.heronav--hero, .heronav--overlay:not(.heronav--minimal)) {
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background .4s ease, border-color .4s ease;
  }
  :is(.heronav--hero, .heronav--overlay:not(.heronav--minimal)) .heronav-inner { padding-block: clamp(16px, 1.6vw, 22px); }
  :is(.heronav--hero, .heronav--overlay:not(.heronav--minimal)) .heronav-logo { height: clamp(28px, 3vw, 34px); }
  :is(.heronav--hero, .heronav--overlay:not(.heronav--minimal)).is-on-light {
    background: #0B0A11;
    border-bottom-color: rgba(201, 164, 106, .18);
  }
  :is(.heronav--hero, .heronav--overlay:not(.heronav--minimal)).is-on-light .heronav-inner { color: #F6F3EC; }
  /* Fondo oscuro sólido del navbar → logo de marca original (morado + crema). */
  :is(.heronav--hero, .heronav--overlay:not(.heronav--minimal)).is-on-light .heronav-logo-colored { opacity: 0; }
  :is(.heronav--hero, .heronav--overlay:not(.heronav--minimal)).is-on-light .heronav-logo-dark { opacity: 0; }
  :is(.heronav--hero, .heronav--overlay:not(.heronav--minimal)).is-on-light .heronav-logo-brand { opacity: 1; }

  /* Fondo oscuro debajo → lino claro (logo blanco). Coincide con el estado base del navbar. */
  :is(.heronav--hero, .heronav--overlay).is-on-dark .heronav-inner { color: #F6F3EC; }
  :is(.heronav--hero, .heronav--overlay).is-on-dark .heronav-logo-colored { opacity: 1; }
  :is(.heronav--hero, .heronav--overlay).is-on-dark .heronav-logo-dark { opacity: 0; }

  /* Los timelines de scroll SOLO aplican a la variante hero (home). Aquí solo la ENTRADA
     (aparición del navbar) sigue enganchada al recorrido del hero; el COLOR lo lleva el script.
     `both` mantiene opacidad 0 antes del rango → navbar invisible durante el cover morado. */
  @supports (animation-timeline: view()) {
    .heronav--hero {
      animation: gg-fade linear both;
      animation-timeline: --enter;
      animation-range: cover 46% cover 64%;
    }
  }

  /* El reveal del navbar es solo opacidad (no es movimiento): se conserva bajo
     reduced-motion restaurando la duración auto que el reset global fija a .001ms
     (rompería el scrub por scroll). */
  @media (prefers-reduced-motion: reduce) {
    .heronav--hero { animation-duration: auto !important; }
  }

  /* ---- Variante SÓLIDA (todas las páginas salvo la home) ----
     Sticky con fondo oscuro de marca: mismos enlaces y logo claro que sobre el hero, pero
     con fondo para legibilidad y ocupando su espacio en el flujo (no tapa el contenido). */
  .heronav--solid {
    position: sticky;
    pointer-events: auto;
    background: #0B0A11;
    border-bottom: 1px solid rgba(201, 164, 106, .18);
  }
  .heronav--solid .heronav-inner {
    padding-block: clamp(14px, 1.8vw, 22px);
    color: #F6F3EC;
  }
  /* Navbar sólido (fondo oscuro siempre) → logo de marca original (morado + crema). */
  .heronav--solid .heronav-logo-colored { opacity: 0; }
  .heronav--solid .heronav-logo-brand { opacity: 1; }

  /* ---- Variante MINIMAL (solo detalle de propiedad) ----
     Coreografía por scroll (la conduce el script del detalle con .pd-logo-off / .pd-nav-on,
     NO elementFromPoint). El logo y la barra final comparten la MISMA celda (se apilan):
       · base (sobre la foto): solo el logo blanco arriba a la izquierda.
       · .pd-logo-off (la lámina de specs llega arriba y lo cubre): el logo se desvanece.
       · .pd-nav-on (la barra de specs ya pasó del todo): entran la hamburguesa + el logo
         negro monocromo a su derecha, y acompañan el resto del recorrido. Sin fondo: esta
         página es la única sin navbar con fondo. */
  .heronav--minimal .heronav-morph {
    display: grid;
    align-items: center;
    justify-items: start;
  }
  .heronav--minimal .heronav-morph > * { grid-area: 1 / 1; }
  /* El logo minimal solo se ve sobre la foto → siempre el diamante blanco (sin swap a oscuro). */
  .heronav--minimal .heronav-morph-logo .heronav-logo-dark { display: none; }
  .heronav--minimal .heronav-morph-logo .heronav-logo-colored { opacity: 1; }
  .heronav--minimal .heronav-morph-logo {
    transition: opacity .45s ease, transform .45s cubic-bezier(.23, 1, .32, 1), visibility .45s;
  }

  /* Barra final: hamburguesa (izq) + logo negro (der). Oculta hasta .pd-nav-on. */
  .heronav--minimal .heronav-morph-bar {
    display: inline-flex;
    align-items: center;
    gap: clamp(13px, 1.3vw, 18px);
    color: #14101C;                     /* líneas de la hamburguesa en tinta (sobre lámina clara) */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .45s ease, visibility .45s, color .4s ease;
  }
  .heronav-morph-burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;            /* líneas alineadas al borde izquierdo */
    gap: 5px;
    width: 30px;
    height: 24px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .heronav-morph-burger span {
    display: block;
    width: 30px;
    height: 1.6px;
    background: currentColor;
    border-radius: 1px;
  }
  .heronav-morph-mark { position: relative; display: inline-flex; height: clamp(28px, 3vw, 34px); }
  .heronav-morph-mark-img { height: 100%; width: auto; display: block; transition: opacity .45s ease; }
  /* La variante blanca se superpone a la oscura y se revela sobre fondo oscuro. */
  .heronav-morph-mark--white { position: absolute; top: 0; left: 0; opacity: 0; }

  /* Estado: la lámina cubre el navbar → el logo blanco desaparece. */
  .heronav--minimal.pd-logo-off .heronav-morph-logo {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px);
  }
  /* Estado: la barra de specs ya pasó → entran hamburguesa + logo negro (las 3 líneas salen
     con un leve escalonado; el logo las sigue). */
  .heronav--minimal.pd-nav-on .heronav-morph-bar {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .heronav--minimal .heronav-morph-burger span,
  .heronav--minimal .heronav-morph-mark {
    transform: translateY(-7px);
    transition: transform .5s cubic-bezier(.23, 1, .32, 1);
  }
  .heronav--minimal.pd-nav-on .heronav-morph-burger span,
  .heronav--minimal.pd-nav-on .heronav-morph-mark { transform: none; }
  .heronav--minimal.pd-nav-on .heronav-morph-burger span:nth-child(1) { transition-delay: .04s; }
  .heronav--minimal.pd-nav-on .heronav-morph-burger span:nth-child(2) { transition-delay: .11s; }
  .heronav--minimal.pd-nav-on .heronav-morph-burger span:nth-child(3) { transition-delay: .18s; }
  .heronav--minimal.pd-nav-on .heronav-morph-mark { transition-delay: .2s; }

  /* Contraste adaptativo del estado final: cuando el navbar pasa sobre una banda oscura
     (data-navtone="dark", p. ej. "Características"), la hamburguesa y el logo monocromo se
     animan a BLANCO; sobre fondo claro vuelven a tinta. Lo conmuta el script del detalle con
     .pd-on-dark; la transición vive en color/opacity (arriba). */
  .heronav--minimal.pd-on-dark .heronav-morph-bar { color: #F6F3EC; }
  .heronav--minimal.pd-on-dark .heronav-morph-mark--dark { opacity: 0; }
  .heronav--minimal.pd-on-dark .heronav-morph-mark--white { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .heronav--minimal .heronav-morph-logo,
    .heronav--minimal .heronav-morph-bar { transition-property: opacity, visibility; }
    .heronav--minimal .heronav-morph-burger span,
    .heronav--minimal .heronav-morph-mark { transition: none; transform: none; }
  }

  /* ---- Drawer lateral (menú del detalle) ---- */
  .gg-drawer {
    position: fixed;
    inset: 0;
    z-index: 70;
    font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;
  }
  .gg-drawer[hidden] { display: none; }
  .gg-drawer-scrim {
    position: absolute;
    inset: 0;
    background: rgba(11, 10, 17, .55);
    opacity: 0;
    transition: opacity .24s ease;
  }
  .gg-drawer.is-open .gg-drawer-scrim { opacity: 1; transition-duration: .3s; }
  .gg-drawer-panel {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: min(88vw, 380px);
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 4vw, 36px) clamp(22px, 4vw, 34px);
    /* Morado de la cobertura del hero (el que rodea al diamante del vídeo, #241A2E) con un
       degradado oscuro MUY suave (solo un poco), en vez del casi-negro anterior (#0B0A11). */
    background: radial-gradient(135% 85% at 50% 4%, #2A1F38 0%, #241A2E 48%, #1B1526 100%);
    overflow-y: auto;                       /* con 6 enlaces, scroll si la pantalla es corta */
    box-shadow: 24px 0 60px -30px rgba(0, 0, 0, .7);
    /* Salida (base) más rápida que la entrada; curva de drawer iOS (Ionic). */
    transform: translateX(-100%);
    transition: transform .24s cubic-bezier(.32, .72, 0, 1);
    will-change: transform;
  }
  .gg-drawer.is-open .gg-drawer-panel { transform: translateX(0); transition-duration: .34s; }
  /* Ancho ÚNICO para TODOS los drawers (home, detalle, Nosotros, etc.): en escritorio UN TERCIO
     de la pantalla (33.33vw); en móvil el ancho usable base de arriba. El cap alto deja que el
     tercio se vea completo también en monitores anchos. */
  @media (min-width: 881px) {
    .gg-drawer-panel { width: clamp(320px, 33.333vw, 680px); }
  }
  .gg-drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(30px, 6vw, 52px);
  }
  .gg-drawer-logo { width: 60px; height: auto; display: block; }
  /* Cierre: botón circular con filete bronce que se RELLENA en hover mientras el aspa gira 90°
     (micro-interacción cuidada; nada de la "X" pelada por defecto). */
  .gg-drawer-close {
    width: 42px; height: 42px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid color-mix(in srgb, #C9A46A 42%, transparent);
    border-radius: 999px;
    color: #F6F3EC;
    cursor: pointer;
    transition:
      background .35s cubic-bezier(.23, 1, .32, 1),
      border-color .35s cubic-bezier(.23, 1, .32, 1),
      color .35s cubic-bezier(.23, 1, .32, 1),
      transform .45s cubic-bezier(.23, 1, .32, 1);
  }
  .gg-drawer-close:hover {
    background: #C9A46A;
    border-color: #C9A46A;
    color: #0B0A11;
    transform: rotate(90deg);
  }
  .gg-drawer-close:active { transform: rotate(90deg) scale(.9); }
  @media (prefers-reduced-motion: reduce) {
    .gg-drawer-close { transition: background .3s ease, border-color .3s ease, color .3s ease; }
    .gg-drawer-close:hover, .gg-drawer-close:active { transform: none; }
  }
  .gg-drawer-nav {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2.6vw, 24px);
    /* Enlaces corridos un poco más a la derecha (dentro del panel). */
    padding-left: clamp(34px, 4.4vw, 54px);
  }
  /* Enlaces del menú: EXACTAMENTE la tipografía de los títulos de tarjeta de Contáctanos
     (.gg-card-title) → Fraunces (display), peso 400, caja natural. El hover/activo COLOREA el
     botón en dorado (antes se subrayaba con un filete dorado fino). */
  .gg-drawer-link {
    width: fit-content;
    color: #F6F3EC;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 4.4vw, 1.9rem);
    letter-spacing: -.01em;
    text-transform: uppercase;
    transition: color .3s ease;
  }
  .gg-drawer-link:hover,
  .gg-drawer-link.is-active { color: #C9A46A; }
  .gg-drawer-wa {
    margin-top: auto;                    /* ancla el botón al fondo del panel */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    color: #100E17;
    text-decoration: none;
    background: #C9A46A;
    border-radius: 2px;
    padding: 15px 22px;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: .16em;
    text-transform: uppercase;
    transition: transform .16s ease, background .3s ease;
  }
  .gg-drawer-wa:active { transform: scale(.97); }
  .gg-drawer-close:focus-visible,
  .gg-drawer-link:focus-visible,
  .gg-drawer-wa:focus-visible { outline: 2px solid #C9A46A; outline-offset: 4px; }
  /* <body> vive fuera del componente → :global para el bloqueo de scroll con el drawer abierto. */
  :global(body.gg-drawer-lock) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .gg-drawer-panel { transition: none; }
  }
</style>

<script>
  // Drawer lateral (solo detalle de propiedad · variante minimal). Abre/cierra con animación
  // interrumpible (clases + transición CSS), bloquea el scroll del body, mueve el foco al
  // cierre, lo devuelve al abridor, atrapa Tab dentro del panel y cierra con Esc / scrim / enlace.
  const drawer = document.getElementById('gg-drawer');
  // Drawer ÚNICO compartido por toda la web. Lo abre cualquier hamburguesa [data-drawer-open]:
  // la de la home (#gg-hero-drawer-open), la del detalle (#gg-drawer-open) y la hamburguesa móvil
  // (.heronav-burger) del resto de páginas. Recordamos el último abridor para devolverle el foco.
  const drawerOpeners = Array.from(
    document.querySelectorAll<HTMLElement>('[data-drawer-open]')
  );
  if (drawer && drawerOpeners.length) {
    const EXIT_MS = 260;
    let closeTimer = 0;
    let lastOpener: HTMLElement = drawerOpeners[0];
    const setDrawer = (open: boolean, opener?: HTMLElement) => {
      if (open) {
        if (opener) lastOpener = opener;
        window.clearTimeout(closeTimer);
        drawer.hidden = false;
        requestAnimationFrame(() => drawer.classList.add('is-open'));
        document.body.classList.add('gg-drawer-lock');
        drawerOpeners.forEach((b) => b.setAttribute('aria-expanded', 'false'));
        lastOpener.setAttribute('aria-expanded', 'true');
        (drawer.querySelector('#gg-drawer-close') as HTMLElement | null)?.focus();
      } else {
        drawer.classList.remove('is-open');
        document.body.classList.remove('gg-drawer-lock');
        drawerOpeners.forEach((b) => b.setAttribute('aria-expanded', 'false'));
        closeTimer = window.setTimeout(() => { drawer.hidden = true; }, EXIT_MS);
        lastOpener.focus();
      }
    };
    drawerOpeners.forEach((b) => b.addEventListener('click', () => setDrawer(true, b)));
    drawer.querySelectorAll('[data-drawer-close], .gg-drawer-link, .gg-drawer-wa')
      .forEach((el) => el.addEventListener('click', () => setDrawer(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) setDrawer(false);
    });
    // Atrapa el foco dentro del panel mientras el drawer está abierto (aria-modal).
    drawer.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const f = drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
      if (!f.length) return;
      const first = f[0];
      const last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  }
</script>

<script>
  // Contraste adaptativo del navbar (solo variante hero / home). El navbar es fijo y cruza
  // bandas de distinto tono según se baja. Miramos qué elemento [data-navtone] queda bajo el
  // CENTRO del navbar: elementFromPoint respeta el apilamiento del efecto "scroll-over" y
  // devuelve la banda que está DELANTE (la que realmente se ve). Con eso decidimos si el
  // navbar debe ir claro (sobre oscuro) u oscuro (sobre claro). rAF-throttled → sin jank.
  const heronav = document.querySelector('.heronav--hero, .heronav--overlay:not(.heronav--minimal)');
  if (heronav instanceof HTMLElement) {
    const inner = heronav.querySelector('.heronav-inner');
    let ticking = false;

    const isHeroNav = heronav.classList.contains('heronav--hero');

    const apply = () => {
      ticking = false;
      const ref = inner instanceof HTMLElement ? inner : heronav;
      const box = ref.getBoundingClientRect();
      const x = Math.round(window.innerWidth / 2);
      // Franja vertical que ocupa el navbar (de su borde superior al inferior). Para el hero el
      // navbar es más delgado que antes, pero el cambio debe seguir el MISMO timing de siempre →
      // medimos sobre la altura del navbar ORIGINAL (más alto). clamp() replica el CSS previo
      // (padding vertical clamp(20,3.4vw,34) + logo clamp(30,3.4vw,38)). Para 'overlay' se usa
      // la caja real del navbar (su altura no cambió).
      const clampPx = (min: number, vw: number, max: number) =>
        Math.min(Math.max(min, (vw / 100) * window.innerWidth), max);
      const top = isHeroNav ? 2 : Math.round(box.top + 2);
      const bottom = isHeroNav
        ? Math.round(clampPx(20, 3.4, 34) * 2 + clampPx(30, 3.4, 38))
        : Math.round(box.bottom - 2);
      // Muestreamos VARIOS puntos a lo alto del navbar (no solo el centro). Regla: si CUALQUIER
      // punto cae sobre una banda clara, el navbar conserva su fondo oscuro sólido (legible sobre
      // claro y sobre oscuro). Solo "desaparece" (transparente) cuando TODO el navbar entra por
      // completo en una banda oscura → ya no se transparenta cuando apenas la mitad ha entrado y
      // la otra mitad sigue sobre el fondo claro de la sección anterior (perdía contraste).
      // El header tiene pointer-events:none (sus enlaces no caen en el centro x), así que
      // elementFromPoint atraviesa el navbar y devuelve la banda que hay debajo en cada punto.
      const ys = [top, Math.round((top + bottom) / 2), bottom];
      let anyLight = false;
      for (const y of ys) {
        const hit = document.elementFromPoint(x, y);
        const band = hit ? hit.closest('[data-navtone]') : null;
        if (band && band.getAttribute('data-navtone') === 'light') { anyLight = true; break; }
      }
      // Sin banda clara bajo ningún punto (incl. hero, por encima de todo) → oscuro → navbar claro.
      const dark = !anyLight;
      heronav.classList.toggle('is-on-dark', dark);
      heronav.classList.toggle('is-on-light', !dark);
    };

    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(apply); }
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    addEventListener('load', apply);
    apply();
  }

  // Revelado por scroll del navbar sólido (página Propiedades): al bajar, añade .is-scrolled
  // → el logo desliza y aparece la hamburguesa del drawer (mismo gesto que la home en
  // "Inmuebles destacados"). Inicialmente, sin scroll, queda como el sólido de siempre.
  // rAF-throttled (mismo patrón que el contraste adaptativo); histéresis mínima para no
  // parpadear en el umbral.
  const srNav = document.querySelector('.heronav--scroll-reveal');
  if (srNav instanceof HTMLElement) {
    let srTicking = false;
    const srApply = () => {
      srTicking = false;
      const y = window.scrollY || document.documentElement.scrollTop;
      const on = srNav.classList.contains('is-scrolled');
      // Umbral asimétrico: activa a 28px, desactiva a 6px (evita jitter al borde del hero).
      if (!on && y > 28) srNav.classList.add('is-scrolled');
      else if (on && y < 6) srNav.classList.remove('is-scrolled');
    };
    const srOnScroll = () => {
      if (!srTicking) { srTicking = true; requestAnimationFrame(srApply); }
    };
    addEventListener('scroll', srOnScroll, { passive: true });
    srApply();
  }
</script>
