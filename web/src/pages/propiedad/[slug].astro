<style>
  /* La página usa la paleta literal del diseño (no los tokens @theme del sitio) para
     reproducirlo con exactitud: dorado #C9A46A / #B98F55, tinta #14101C / #100E17,
     papel #FCFBF8 / #F3F0E9 / #F6F3EC. Tipografía Montserrat (la del sitio). */
  .pd {
    font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;
    color: #14101C;
    background: #FCFBF8;
    /* Altura de la barra de specs. El hero ocupa el resto de la pantalla → los specs quedan
       justo al pie del viewport y la foto abarca casi toda la pantalla. (El hero se ajusta
       en la misma medida, así el TAMAÑO TOTAL de la página no cambia.) */
    --pd-spec-h: clamp(104px, 12vh, 132px);
  }

  /* ---- Efecto scroll-over: la foto del hero queda fija y el contenido la cubre al bajar ----
     Réplica del de la home: el hero se ANCLA (sticky) y la lámina de contenido, opaca y con
     z-index superior, sube y lo CUBRE en lugar de desplazarlo. El núcleo es puro layout (sin
     JS, universal); el oscurecido progresivo usa scroll-timeline donde esté disponible. */
  .pd-reveal { timeline-scope: --cover; }
  .pd-hero-sticky {
    position: sticky;
    top: 0;
    z-index: 0;
    /* `hidden` (no `clip`): contiene el ken-burns igual, pero evita un bug de repintado de
       Chromium con `overflow: clip` en capas compuestas, que dejaba un cuadrado de "píxeles
       rotos" (tile GPU obsoleto) a la derecha durante el scroll. */
    overflow: hidden;
    background: #0B0A11;  /* base oscura: si el parallax deja un hilo al fondo, se ve tinta, no blanco */
  }
  .pd-scroll-over {
    position: relative;
    z-index: 1;
    background: #FCFBF8;
    /* Sombra superior tenue y tintada: sensación de lámina que se posa sobre la foto. */
    box-shadow: 0 -34px 60px -24px color-mix(in srgb, #14101C 60%, transparent);
  }
  .pd-reveal-sentinel {
    view-timeline: --cover block;
    height: 1px;
    margin-bottom: -1px;
  }
  .pd-hero-darken {
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: #0B0A11;
    opacity: 0;
  }
  /* Oscurecido MUY tenue al cubrirse: solo suaviza la transición cuando la lámina se posa,
     sin ensombrecer la foto. El hero NO se mueve (nada de parallax que dejaba un hilo abajo)
     y el texto conserva su color (no se desvanece). */
  @keyframes pd-hero-darken { from { opacity: 0; } to { opacity: .22; } }
  @supports (animation-timeline: view()) {
    .pd-hero-darken {
      animation: pd-hero-darken linear both;
      animation-timeline: --cover;
      animation-range: cover 55% cover 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pd-hero-darken { animation: none; }
  }

  /* ---- HERO ---- */
  .pd-hero {
    position: relative;
    /* Base (móvil): foto grande. Desktop: casi pantalla completa (ver media query). */
    height: 76svh;
    min-height: 480px;
    overflow: hidden;
    background: #14101C;
    color: #F6F3EC;
  }
  /* Desktop: la foto ocupa la pantalla completa MENOS la barra de specs, que queda al pie. */
  @media (min-width: 768px) {
    .pd-hero { height: calc(100svh - var(--pd-spec-h)); min-height: 560px; }
  }
  /* Zoom sostenido y NÍTIDO: la capa se queda al tamaño del hero (100%), sin sobreescalar,
     para no forzar una textura enorme (eso era lo que pixelaba en pantallas grandes/retina).
     El zoom es leve y SIN paneo → nunca deja borde ni obliga a ampliar mucho la foto. */
  .pd-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform-origin: center;
    will-change: transform;
    /* Capa compuesta estable: evita que el compositor muestre un tile a medio rasterizar
       (los "píxeles rotos") al recomponer durante el scroll/ken-burns. */
    backface-visibility: hidden;
    transform: translateZ(0);
    animation: pd-ken 34s ease-in-out infinite alternate;
  }
  .pd-hero-media picture, .pd-hero-media img, .pd-hero-ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @keyframes pd-ken {
    from { transform: scale(1); }
    to   { transform: scale(1.015); }
  }
  /* Velos aligerados: solo lo justo para legibilidad del texto (la nitidez y color de la
     foto quedan a la vista, sin exceso de sombra). La legibilidad del título se refuerza con
     text-shadow, no oscureciendo toda la imagen. */
  .pd-hero-veil-x {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgba(11,10,17,.58) 0%, rgba(11,10,17,.30) 34%, rgba(11,10,17,.06) 62%, rgba(11,10,17,0) 100%);
  }
  .pd-hero-veil-b {
    position: absolute; left: 0; right: 0; bottom: 0; height: 52%; z-index: 1; pointer-events: none;
    background: linear-gradient(0deg, rgba(11,10,17,.54) 0%, rgba(11,10,17,.14) 60%, rgba(11,10,17,0) 100%);
  }
  /* Mismo margen lateral que la barra de specs de abajo (.pd-specbar-inner): a sangre
     completa, sin la caja centrada de 1600px, con el padding lateral clamp(16px, 2.4vw, 44px).
