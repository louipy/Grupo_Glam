  }
  /* Aro dorado alrededor de la foto (padding de 2px sobre un degradado de oro). */
  .pd-agent-photo-wrap {
    flex: 0 0 auto;
    width: 74px;
    height: 74px;
    border-radius: 50%;
    padding: 2px;
