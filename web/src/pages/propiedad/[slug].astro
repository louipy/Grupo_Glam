    color: #4A4650;
    text-wrap: pretty;
  }

  /* ---- TARJETA DE CONTACTO (asesor + formulario) ----
     Morado de marca (#241A2E, el de las bandas oscuras de la home) en cabecera y botones;
     el resto conserva la paleta crema/oro/tinta de la página. Easing fuerte y tiempos cortos
     (<220ms) en hover/foco para que se sienta fluida sin latencia. */
  .pd-aside {
    --morado: #241A2E;
    --morado-top: #2E2240;      /* cara superior del degradado / hover */
    --morado-deep: #1B1526;     /* base del degradado */
