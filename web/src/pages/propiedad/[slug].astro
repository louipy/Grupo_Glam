    transition: transform .18s var(--ease), color .18s ease;
  }
  .pd-field input:focus + .pd-field-label,
  .pd-field input:not(:placeholder-shown) + .pd-field-label,
  .pd-field textarea:focus + .pd-field-label,
  .pd-field textarea:not(:placeholder-shown) + .pd-field-label {
    transform: translateY(-8px) scale(.8);
    color: #B98F55;
  }

  /* Botón primario morado (con relieve sutil). */
  .pd-form-submit {
    margin-top: 4px;
    width: 100%;
    color: #F6F3EC;
