  /* Campos con etiqueta flotante (sin placeholder-as-label): la etiqueta vive dentro del
     campo y sube al enfocar o cuando hay texto. El input lleva placeholder=" " para activar
     :placeholder-shown sin mostrar texto fantasma. */
  .pd-field { position: relative; }
  .pd-field input,
  .pd-field textarea {
    width: 100%;
    border: 1px solid rgba(20,16,28,.16);
    border-radius: 2px;
    background: #fff;
    font-family: inherit;
    font-size: 13.5px;
    letter-spacing: .02em;
    color: #14101C;
