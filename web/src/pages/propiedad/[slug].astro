  .pd-hero-btn:focus-visible { outline: 2px solid #C9A46A; outline-offset: 3px; }
  .pd-hero-price {
    position: absolute;
    right: clamp(16px, 2.4vw, 44px);
    bottom: clamp(28px, 4vw, 56px);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    animation: pd-rise .95s cubic-bezier(.2,0,0,1) .2s both;
    text-shadow: 0 2px 20px rgba(11,10,17,.6);
  }
  .pd-hero-price-k {
    font-weight: 600;
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: rgba(246,243,236,.82);
  }
  .pd-hero-price-v {
    margin-top: 6px;
    font-weight: 400;
    font-size: clamp(2.1rem, 4.2vw, 3.3rem);
    letter-spacing: .005em;
    line-height: 1;
    color: #F6F3EC;
  }
  @keyframes pd-rise {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: none; }
  }

  /* ---- SPEC BAR ---- */
  /* Contenedor de anclaje: la barra se queda pegada arriba (sticky) mientras el contenedor
     está en pantalla; la altura extra respecto a la barra es el "dwell" (el instante que
     permanece anclada antes de despegarse y pasar del todo). */
  .pd-specbar-pin { position: relative; z-index: 7; }
  .pd-specbar {
    position: sticky;
    top: 0;
    background: #F3F0E9;
    border-bottom: 1px solid rgba(20,16,28,.07);
  }
  /* Igual que la fila de logos de "Aliados comerciales": a todo el ancho (full-bleed),
     aprovechando los laterales. Las cifras se reparten con space-between y el mismo padding
     lateral clamp(16px, 2.4vw, 44px). No se altera el tamaño de la web ni del texto: solo se
     distribuyen horizontalmente usando el espacio de los lados. */
  .pd-specbar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(18px, 2.4vw, 44px);
    padding: 0 clamp(16px, 2.4vw, 44px);
  }
  @media (min-width: 768px) {
    /* Altura fija = la foto de arriba llega exactamente hasta el borde de esta barra. */
    .pd-specbar { height: var(--pd-spec-h); }
    .pd-specbar-inner { height: 100%; flex-wrap: nowrap; }
    /* Dwell del anclaje: la barra permanece arriba durante este recorrido extra antes de
       despegarse. Es el "instante presente" que pediste entre apilado y paso completo. */
    .pd-specbar-pin { height: calc(var(--pd-spec-h) + clamp(200px, 32vh, 340px)); }
  }
  /* Número + etiqueta EN LÍNEA ("6 HABITACIONES"), alineados a la baseline: el número manda
     (tamaño/peso) y la etiqueta lo acompaña en versalitas. Sin divisiones y sin crecer → se
     reparten con space-between usando los laterales. */
  .pd-spec {
    flex: 0 0 auto;
    display: flex;
    align-items: baseline;
    gap: clamp(8px, 0.7vw, 12px);
    padding: clamp(14px, 1.6vw, 20px) 0;
  }
  .pd-spec-v {
    font-weight: 400;
    font-size: clamp(2rem, 2.9vw, 2.9rem);
    letter-spacing: .01em;
    line-height: 1;
    color: #14101C;
    font-variant-numeric: tabular-nums;
  }
  .pd-spec-l {
    font-weight: 600;
    font-size: clamp(12.5px, 1.05vw, 15px);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #9A948B;
  }

  /* ---- DESCRIPTION ---- */
  .pd-desc-sec {
    max-width: 1600px;
    margin: 0 auto;
    /* Top reducido: sube "La propiedad" en el eje Y, pegándolo más a la barra de specs.
       El padding inferior se conserva para no comprimir la separación con Características. */
    padding: clamp(18px, 2.4vw, 38px) clamp(20px, 5vw, 54px) clamp(44px, 5.5vw, 84px);
  }
  /* Párrafo a la izquierda + tarjeta del asesor a la derecha (el nuevo punto de contacto). */
  .pd-desc-grid {
