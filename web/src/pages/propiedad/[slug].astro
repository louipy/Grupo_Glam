---
import Base from '../../layouts/Base.astro';
import HeroNav from '../../components/HeroNav.astro';
import CatalogoPropiedadCard from '../../components/CatalogoPropiedadCard.astro';
import { Image } from 'astro:assets';
import mariaLuisaNolck from '../../assets/equipo/maria-luisa-nolck.jpg';
import { propiedadesDemo, type PropiedadDemo } from '../../data/propiedades.sample';
import { precioES } from '../../lib/formato';

// Página de detalle de propiedad. Reproduce fielmente el diseño DESIGN/Propiedad.dc.html
// (hero, barra de specs, descripción + tarjeta de contacto, galería, características + mapa,
// propiedades similares) sobre la cabecera y el pie del sitio (Base → HeroNav + Footer).
// El diseño es autocontenido con su propia paleta literal (dorado #C9A46A, tinta #14101C,
// papel #FCFBF8/#F3F0E9); se conservan esos valores tal cual para copiarlo sin desviaciones.

export function getStaticPaths() {
  const slug = (p: PropiedadDemo) =>
    `${p.operacion}-${p.tipo}-${p.zonaSlug}-${p.ref.toLowerCase()}`;
  return propiedadesDemo.map((p) => ({ params: { slug: slug(p) }, props: { p } }));
}

interface Props { p: PropiedadDemo }
const { p } = Astro.props;

// Fotos reales disponibles (mismas que la home / catálogo). El resto cae al degradado de marca.
const fotos: Record<string, { img: string; alt: string }> = {
  'DEMO-01': { img: 'sebucan-edificio', alt: 'Edificio residencial de alta gama en Sebucán' },
  'DEMO-02': { img: 'la-castellana-jardin', alt: 'Casa con jardín y piscina en La Castellana' },
  'DEMO-03': { img: 'los-palos-grandes-interior', alt: 'Salón luminoso de apartamento en Los Palos Grandes' },
  'DEMO-04': { img: 'altamira-terraza', alt: 'Terraza con vista al Ávila en Altamira' },
};
const foto = fotos[p.ref];

// Variantes por foto: 640/1280 nativas + 1920/2560 reescaladas en alta calidad (Lanczos +
// realce) para que las pantallas grandes/retina no tengan que ampliar la imagen por su cuenta
// (que es lo que restaba nitidez en el hero a pantalla completa). `Full` para usos grandes
// (hero, foto grande de la galería); `Card` para las tarjetas pequeñas de similares.
// Fotos que ya tienen máster de alta resolución (Upscayl) con variante -3840 generada.
// Solo a estas se les añade el candidato 3840w al srcset; el resto corta en 2560 para no
// pedir un archivo que no existe (evita 404 en pantallas 4K/retina).
const hiRes = new Set(['la-castellana-jardin', 'sebucan-edificio', 'altamira-terraza']);
const srcsetFull = (img: string, ext: string) =>
  `/destacados/${img}-640.${ext} 640w, /destacados/${img}-1280.${ext} 1280w, /destacados/${img}-1920.${ext} 1920w, /destacados/${img}-2560.${ext} 2560w` +
  (hiRes.has(img) ? `, /destacados/${img}-3840.${ext} 3840w` : '');

const wa = 'https://wa.me/584122398253';
const city = 'Caracas';

const tipoLabel: Record<string, string> = {
  apartamento: 'apartamento', casa: 'casa', edificio: 'edificio',
  local: 'local comercial', oficina: 'oficina', terreno: 'terreno',
};
const tLabel = tipoLabel[p.tipo] ?? 'inmueble';

// Precio (formato del sitio, §7.4) + kicker según operación.
const price = precioES(p.precio, p.aConsultar);
const priceKicker = p.aConsultar
  ? 'Consultar'
  : p.operacion === 'venta' ? 'Precio de venta' : 'Precio de alquiler';

// Barra de specs (§6.2: null/0 → no se renderiza).
const specs = [
  p.habitaciones ? { label: 'Habitaciones', value: String(p.habitaciones) } : null,
  p.banos ? { label: 'Baños', value: String(p.banos) } : null,
  p.puestos ? { label: 'Estacionamientos', value: String(p.puestos) } : null,
  p.area ? { label: 'Superficie', value: `${p.area} m²` } : null,
].filter(Boolean) as { label: string; value: string }[];

// Descripción derivada de datos reales (no inventa amenidades).
const partes = [
  p.habitaciones ? `${p.habitaciones} habitaciones` : null,
  p.banos ? `${p.banos} baños` : null,
  p.puestos ? `${p.puestos} puestos de estacionamiento` : null,
].filter(Boolean) as string[];
const distrib = partes.length
  ? `Distribuida en ${partes.join(', ')}${p.area ? ` y ${p.area} m² de superficie` : ''}, `
  : '';
const description = [
  `Ubicada en ${p.zona}, una de las zonas más valoradas de Caracas, esta ${tLabel} combina una ubicación privilegiada con espacios amplios y luminosos, pensados para el confort y la vida contemporánea.`,
  `${distrib}aprovecha la luz natural en cada ambiente y ofrece una distribución funcional a la altura de las mejores direcciones de la ciudad.`,
  `Grupo Glam acompaña cada operación con asesoría integral —valoración, documentación y negociación bajo estándares internacionales— para proteger tu patrimonio en cada paso.`,
];

// Asesor (contenido demo, integrante real del equipo · foto en src/assets/equipo).
const agent = {
  name: 'María Luisa Nolck',
  role: 'Asesora inmobiliaria senior',
  phone: '+58 412 239 8253',
  email: 'marialuisa@grupoglam.com',
};

// Galería: la foto principal ocupa el primer slot (grande); el resto son slots pendientes.
const galleryPhs = [
  'Sala principal con vista a la ciudad',
  'Comedor / cocina abierta',
  'Habitación principal',
  'Baño principal en mármol',
  'Terraza / balcón',
];
// Slides del visor (lightbox): refleja la galería 1:1. El primer slot es la foto real; el
// resto son slots pendientes (mismo placeholder de marca). Cuando se carguen fotos reales,
// el visor las sirve automáticamente. Todos comparten forma para evitar narrowing en el template.
const gallerySlides = galleryPhs.map((caption, idx) =>
  idx === 0 && foto
    ? { kind: 'photo' as const, img: foto.img, alt: foto.alt, caption, tono: p.tono }
    : { kind: 'pending' as const, img: '', alt: '', caption, tono: p.tono }
);

// Características (contenido demo representativo, coherente con el diseño).
const unitFeatures = [
  'Aire acondicionado', 'Completamente amueblado', 'Balcón / terraza', 'Cocina equipada',
  'Vestidores', 'Baños en mármol', 'Ventanales piso-techo', 'Depósito privado',
];
const buildingFeatures = [
  'Gimnasio', 'Piscina', 'Salón de eventos', 'Seguridad 24 horas',
  'Planta eléctrica', 'Estacionamiento techado', 'Estacionamiento de visitantes', 'Lobby panorámico',
];

const showMap = p.lat != null && p.lng != null;

// Propiedades similares (hasta 4, priorizando la misma operación). Se sirven con la MISMA
// tarjeta del catálogo (CatalogoPropiedadCard) → idéntico diseño y comportamiento.
const similar = propiedadesDemo
  .filter((x) => x.ref !== p.ref)
  .sort((a, b) => Number(b.operacion === p.operacion) - Number(a.operacion === p.operacion))
  .slice(0, 4);
---
<Base
  title={`${p.titulo} — ${p.zona}, ${city} | Grupo Glam Inmobiliaria`}
  description={`${p.titulo} en ${p.zona}, ${city}. ${specs.map((s) => `${s.value} ${s.label.toLowerCase()}`).join(' · ')}. Venta y alquiler de alta gama con Grupo Glam.`}
  showHeader={false}
>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <div class="pd pd-reveal">
    <!-- Navbar transparente sobre el hero (mismo estilo que la home, sin franja oscura).
         'overlay' = color adaptativo por scroll y SIEMPRE visible (sin la cortina/timeline
         de entrada de la home). 'minimal' = solo el logo; al cubrirlo la lámina de contenido
         se transforma en hamburguesa que abre el drawer lateral con los enlaces. -->
    <HeroNav variant="overlay" minimal />

    <!-- HERO (sticky): se queda fijo mientras la lámina de contenido lo cubre al bajar. -->
    <div class="pd-hero-sticky" data-navtone="dark">
    <section class="pd-hero">
      <div class="pd-hero-media">
        {foto ? (
          <picture>
            <source type="image/avif" srcset={srcsetFull(foto.img, 'avif')} sizes="100vw" />
            <source type="image/webp" srcset={srcsetFull(foto.img, 'webp')} sizes="100vw" />
            <img
              src={`/destacados/${foto.img}-2560.jpg`}
              srcset={srcsetFull(foto.img, 'jpg')}
              sizes="100vw"
              width="1920"
              height="1140"
              alt={foto.alt}
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        ) : (
          <div class="pd-hero-ph" style={`background:${p.tono}`}></div>
        )}
      </div>
      <div class="pd-hero-veil-x" aria-hidden="true"></div>
      <div class="pd-hero-veil-b" aria-hidden="true"></div>

      <div class="pd-hero-inner">
        <div class="pd-hero-copy">
          <h1 class="pd-hero-title">{p.titulo}</h1>
          <div class="pd-hero-loc">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M8 1.6c-2.5 0-4.5 2-4.5 4.5C3.5 9.4 8 14.4 8 14.4s4.5-5 4.5-8.3C12.5 3.6 10.5 1.6 8 1.6Z" stroke="currentColor" stroke-width="1.2"></path><circle cx="8" cy="6.1" r="1.7" stroke="currentColor" stroke-width="1.2"></circle></svg>
            <span>{p.zona}, {city}</span>
          </div>
          <div class="pd-hero-cta">
            <a href="#galeria" class="pd-hero-btn">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><rect x="1.6" y="1.6" width="5" height="5" stroke="currentColor" stroke-width="1.2"></rect><rect x="9.4" y="1.6" width="5" height="5" stroke="currentColor" stroke-width="1.2"></rect><rect x="1.6" y="9.4" width="5" height="5" stroke="currentColor" stroke-width="1.2"></rect><rect x="9.4" y="9.4" width="5" height="5" stroke="currentColor" stroke-width="1.2"></rect></svg>Galería
            </a>
          </div>
        </div>

        <div class="pd-hero-price">
          <span class="pd-hero-price-k">{priceKicker}</span>
          <span class="pd-hero-price-v">{price}</span>
        </div>
      </div>
    </section>
      <!-- Velo que oscurece la foto a medida que la cubren (scroll-driven, sin JS). -->
      <div class="pd-hero-darken" aria-hidden="true"></div>
    </div>

    <!-- Lámina de contenido: sube y CUBRE el hero fijo (mismo efecto que la home). -->
    <div class="pd-scroll-over" data-navtone="light">
    <!-- Centinela de 1px: su recorrido mide cuánto se ha cubierto el hero (view-timeline --cover). -->
    <div class="pd-reveal-sentinel" aria-hidden="true"></div>

    <!-- SPEC BAR · al subir y cubrir el hero se ANCLA arriba un instante (dwell que da la
         altura extra de .pd-specbar-pin) y luego se despega y pasa del todo. El script del
         detalle sincroniza, en ese recorrido, la desaparición del logo y la entrada del nav. -->
    {specs.length > 0 && (
      <div class="pd-specbar-pin">
        <div class="pd-specbar" id="pd-specbar">
          <div class="pd-specbar-inner">
            {specs.map((s) => (
              <div class="pd-spec">
                <span class="pd-spec-v">{s.value}</span>
                <span class="pd-spec-l">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- DESCRIPCIÓN (párrafo de la propiedad) + tarjeta del asesor a la derecha:
         el recuadro del asesor es ahora el punto de contacto (WhatsApp / email). -->
    <section class="pd-desc-sec">
      <div class="pd-desc-grid">
        <div class="pd-desc-body">
          <span class="pd-eyebrow">La propiedad</span>
          {description.map((para) => (
            <p class="pd-desc-p">{para}</p>
          ))}
        </div>

        <aside class="pd-aside">
          <!-- Cabecera del asesor sobre el morado de marca (#241A2E, el de las bandas oscuras
               de la home): la foto real entra optimizada por Astro desde el máster de 2105px,
               así al reducirla al avatar conserva nitidez en pantallas retina. -->
          <div class="pd-agent">
            <span class="pd-agent-photo-wrap">
              <Image
                src={mariaLuisaNolck}
                alt={`${agent.name}, ${agent.role} de Grupo Glam`}
                width={296}
                height={296}
                fit="cover"
                position="top"
                quality={90}
                class="pd-agent-photo"
                loading="lazy"
              />
            </span>
            <span class="pd-agent-id">
              <span class="pd-agent-k">Tu asesora</span>
              <span class="pd-agent-name">{agent.name}</span>
              <span class="pd-agent-role">{agent.role}</span>
            </span>
          </div>

          <form class="pd-form" onsubmit="return false">
            <span class="pd-form-title">Solicita más información</span>
            <label class="pd-field">
              <input type="text" placeholder=" " autocomplete="name" />
              <span class="pd-field-label">Nombre completo</span>
            </label>
            <label class="pd-field">
              <input type="email" placeholder=" " autocomplete="email" />
              <span class="pd-field-label">Correo electrónico</span>
            </label>
            <label class="pd-field">
              <input type="tel" placeholder=" " autocomplete="tel" />
              <span class="pd-field-label">WhatsApp (opcional)</span>
            </label>
            <label class="pd-field pd-field--area">
              <textarea rows="3" placeholder=" "></textarea>
              <span class="pd-field-label">Tu mensaje (opcional)</span>
            </label>
            <button type="submit" class="pd-form-submit">Enviar solicitud</button>

            <div class="pd-form-sep"><span>o contacto directo</span></div>

            <a href={wa} target="_blank" rel="noopener" class="pd-form-wa">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.73-.85-2-.95-.27-.1-.47-.15-.67.15-.2.3-.77.95-.95 1.15-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5 0 1.47 1.08 2.9 1.23 3.1.15.2 2.11 3.23 5.12 4.53.71.31 1.27.49 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.73-.71 1.98-1.39.24-.68.24-1.26.17-1.39-.07-.12-.27-.2-.57-.35ZM12.04 21.5h-.01a9.47 9.47 0 0 1-4.82-1.32l-.35-.2-3.58.94.96-3.49-.23-.36a9.44 9.44 0 0 1-1.45-5.04c0-5.22 4.26-9.47 9.49-9.47 2.53 0 4.91.99 6.7 2.78a9.42 9.42 0 0 1 2.78 6.7c0 5.22-4.26 9.46-9.47 9.46Zm8.06-17.52A11.36 11.36 0 0 0 12.04.65C5.76.65.65 5.76.65 12.04c0 2 .52 3.95 1.52 5.68L.56 23.35l5.77-1.51a11.35 11.35 0 0 0 5.71 1.46h.01c6.28 0 11.39-5.11 11.39-11.39 0-3.04-1.19-5.9-3.34-8.05Z"/></svg>
              Escribir por WhatsApp
            </a>
          </form>
        </aside>
      </div>
    </section>

    <!-- CARACTERÍSTICAS (propiedad + edificio, sin el mapa). data-navtone="dark": al pasar el
         navbar sobre esta banda oscura, su logo + hamburguesa se animan a blanco (ver script). -->
    <section class="pd-feat-sec" data-navtone="dark">
      <div class="pd-feat-grid">
        <div class="pd-feat-cols">
          <div>
            <h3 class="pd-feat-h">Características de la propiedad</h3>
            <div class="pd-feat-list">
              {unitFeatures.map((f) => (
                <div class="pd-feat-item">
                  <span class="pd-feat-dot"></span>
                  <span class="pd-feat-txt">{f}</span>
                </div>
              ))}
            </div>
          </div>
          <div>
            <h3 class="pd-feat-h">Características del edificio</h3>
            <div class="pd-feat-list">
              {buildingFeatures.map((f) => (
                <div class="pd-feat-item">
                  <span class="pd-feat-dot"></span>
                  <span class="pd-feat-txt">{f}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- UBICACIÓN / MAPA (sección propia a todo el ancho) -->
    {showMap && (
      <section class="pd-loc-sec">
        <span class="pd-map-k">Ubicado en</span>
        <h3 class="pd-map-h">{p.zona},<br />{city}</h3>
        <div class="pd-map-frame">
          <div id="gg-map"></div>
        </div>
      </section>
    )}

    <!-- GALERÍA (abajo, como en la referencia) -->
    <section id="galeria" class="pd-gal-sec">
      <div class="pd-gal-head">
        <h2 class="pd-h2">GALERÍA</h2>
        <span class="pd-gal-count">{galleryPhs.length} imágenes</span>
      </div>
      <div class="pd-gal">
        {galleryPhs.map((ph, idx) => (
          <button type="button" class="pd-gal-cell" data-gal-open={idx} aria-label={`Ampliar imagen ${idx + 1} de ${galleryPhs.length}: ${ph}`}>
            {idx === 0 && foto ? (
              <picture>
                <source type="image/avif" srcset={srcsetFull(foto.img, 'avif')} sizes="(min-width:980px) 50vw, 100vw" />
                <source type="image/webp" srcset={srcsetFull(foto.img, 'webp')} sizes="(min-width:980px) 50vw, 100vw" />
                <img
                  class="pd-gal-img"
                  src={`/destacados/${foto.img}-1280.jpg`}
                  srcset={srcsetFull(foto.img, 'jpg')}
                  sizes="(min-width:980px) 50vw, 100vw"
                  width="1280"
                  height="960"
                  alt={foto.alt}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            ) : (
              <div class="pd-gal-ph pd-gal-img" style={`background:${p.tono}`}>
                <span class="pd-pending">Imagen pendiente</span>
              </div>
            )}
            <span class="pd-gal-zoom" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6"/><path d="M15.5 15.5L21 21M10.5 7.5v6M7.5 10.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </span>
          </button>
        ))}
      </div>
    </section>

    <!-- VISOR (lightbox): al pulsar una imagen se abre a pantalla completa; flechas laterales
         (y teclado ←/→) para navegar; Esc o clic en el fondo para cerrar. Solo opacity/transform. -->
    <div class="pd-lb" id="pd-lb" hidden>
      <button type="button" class="pd-lb-btn pd-lb-close" data-lb-close aria-label="Cerrar galería">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <button type="button" class="pd-lb-btn pd-lb-nav pd-lb-prev" data-lb-prev aria-label="Imagen anterior">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="pd-lb-viewport" role="dialog" aria-modal="true" aria-label="Galería de imágenes">
        {gallerySlides.map((s, idx) => (
          <figure class="pd-lb-slide" data-lb-slide={idx} hidden>
            {s.kind === 'photo' ? (
              <picture>
                <source type="image/avif" srcset={srcsetFull(s.img, 'avif')} sizes="100vw" />
                <source type="image/webp" srcset={srcsetFull(s.img, 'webp')} sizes="100vw" />
                <img class="pd-lb-img" src={`/destacados/${s.img}-1920.jpg`} srcset={srcsetFull(s.img, 'jpg')} sizes="100vw" alt={s.alt} decoding="async" />
              </picture>
            ) : (
              <div class="pd-lb-ph" style={`background:${s.tono}`}><span class="pd-pending">Imagen pendiente</span></div>
            )}
            <figcaption class="pd-lb-cap">{s.caption}</figcaption>
          </figure>
        ))}
      </div>
      <button type="button" class="pd-lb-btn pd-lb-nav pd-lb-next" data-lb-next aria-label="Imagen siguiente">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <span class="pd-lb-counter" data-lb-counter aria-hidden="true"></span>
    </div>

    <!-- SIMILAR -->
    {similar.length > 0 && (
      <section class="pd-sim-sec">
        <div class="pd-sim-head">
          <h2 class="pd-h2">Propiedades similares</h2>
          <a href="/propiedades" class="pd-sim-back">Volver al catálogo<span class="pd-sim-back-ico"><svg width="16" height="10" viewBox="0 0 18 12" fill="none"><path d="M1 6h15M11 1l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></a>
        </div>
        <div class="pd-sim-grid">
          {similar.map((sp, idx) => (
            <CatalogoPropiedadCard p={sp} img={fotos[sp.ref]?.img} alt={fotos[sp.ref]?.alt} i={idx} />
          ))}
        </div>
      </section>
    )}
    </div>
  </div>

  <script>
    // Coreografía del navbar minimal del detalle, sincronizada con la barra de specs:
    //   · logo blanco (sobre la foto) → se desvanece cuando la barra llega arriba y lo cubre.
    //   · tras pasar la barra del todo → entran hamburguesa + logo negro (acompañan el resto).
    // Medimos el rect de #pd-specbar; rAF-throttled (mismo patrón que el resto del sitio). El
    // anclaje (dwell) y el apilado son puro CSS (sticky + scroll-over); esto solo sincroniza.
    (function () {
      const nav = document.querySelector('.heronav--minimal');
      const bar = document.getElementById('pd-specbar');
      if (!nav || !bar) return;
      let ticking = false;
      const apply = () => {
        ticking = false;
        const r = bar.getBoundingClientRect();
        // El logo desaparece cuando la barra ya está arriba (cubre la zona del logo).
        nav.classList.toggle('pd-logo-off', r.top <= 60);
        // El nav entra cuando la barra pasó del todo por encima del borde superior.
        nav.classList.toggle('pd-nav-on', r.bottom <= 0);

        // Contraste adaptativo del estado final: ¿qué banda ([data-navtone]) queda bajo el
        // navbar? Muestreamos el centro del navbar a 3 alturas; elementFromPoint respeta el
        // apilamiento del scroll-over y devuelve la banda visible. Si ALGÚN punto cae sobre una
        // banda clara se trata como claro (conservador en las transiciones); solo cuando TODO el
        // navbar entra en la banda oscura pasa a blanco. Logo + hamburguesa → blanco/negro.
        const nb = (nav.querySelector('.heronav-inner') || nav).getBoundingClientRect();
        const x = Math.round(window.innerWidth / 2);
        const ys = [Math.round(nb.top + 4), Math.round((nb.top + nb.bottom) / 2), Math.round(nb.bottom - 4)];
        let anyLight = false;
        for (const y of ys) {
          const el = document.elementFromPoint(x, y);
          const band = el ? el.closest('[data-navtone]') : null;
          if (band && band.getAttribute('data-navtone') === 'light') { anyLight = true; break; }
        }
        nav.classList.toggle('pd-on-dark', !anyLight);
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(apply); } };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      addEventListener('load', apply);
      apply();
    })();
  </script>

  <script>
    // Visor de la galería (lightbox): abre la imagen pulsada a pantalla completa, navega con
    // las flechas laterales o el teclado (←/→), y cierra con Esc / clic en el fondo / botón ✕.
    // Devuelve el foco a la celda de origen al cerrar. Sin librerías; solo opacity/transform.
    (function () {
      const lb = document.getElementById('pd-lb');
      if (!lb) return;
      const slides = Array.from(lb.querySelectorAll('[data-lb-slide]'));
      const counter = lb.querySelector('[data-lb-counter]');
      const openers = Array.from(document.querySelectorAll('[data-gal-open]'));
      if (!slides.length) return;
      let current = 0;
      let lastFocus = null;
      let hideTimer = 0;

      const show = (i) => {
        current = (i + slides.length) % slides.length;
        slides.forEach((s, idx) => { s.hidden = idx !== current; });
        if (counter) counter.textContent = (current + 1) + ' / ' + slides.length;
      };
      const open = (i) => {
        lastFocus = document.activeElement;
        clearTimeout(hideTimer);
        show(i);
        lb.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        requestAnimationFrame(() => lb.classList.add('is-open'));
        lb.querySelector('[data-lb-close]').focus();
      };
      const close = () => {
        lb.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        hideTimer = window.setTimeout(() => { lb.hidden = true; }, 300);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      };

      openers.forEach((btn) => btn.addEventListener('click', () => open(Number(btn.dataset.galOpen))));
      lb.querySelector('[data-lb-prev]').addEventListener('click', () => show(current - 1));
      lb.querySelector('[data-lb-next]').addEventListener('click', () => show(current + 1));
      lb.querySelector('[data-lb-close]').addEventListener('click', close);
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
      document.addEventListener('keydown', (e) => {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') show(current - 1);
        else if (e.key === 'ArrowRight') show(current + 1);
      });
    })();
  </script>

  {showMap && (
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script is:inline define:vars={{ lat: p.lat, lng: p.lng }}>
      (function () {
        function init() {
          var L = window.L;
          var el = document.getElementById('gg-map');
          if (!L || !el) return;
          // Sin controles de zoom: el usuario hace zoom con la rueda al tener el cursor encima.
          var map = L.map(el, { scrollWheelZoom: true, zoomControl: false, attributionControl: false });
          L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { subdomains: 'abc', maxZoom: 19 }).addTo(map);
          // Marcador tipo gota (tinta + núcleo dorado), igual que el catálogo. La punta apunta a la coordenada.
          var icon = L.divIcon({ className: 'gg-pin', html: '<div class="gg-pin-inner"><span class="gg-pin-dot"></span></div>', iconSize: [1, 1] });
          L.marker([lat, lng], { icon: icon }).addTo(map);
          L.circle([lat, lng], { radius: 340, color: '#C9A46A', weight: 1, fillColor: '#C9A46A', fillOpacity: 0.10 }).addTo(map);
          map.setView([lat, lng], 15);
          [120, 400, 900].forEach(function (t) { setTimeout(function () { map.invalidateSize(); }, t); });
        }
        if (window.L) init(); else window.addEventListener('load', init);
      })();
    </script>
  )}
