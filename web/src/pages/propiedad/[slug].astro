    cursor: pointer;
    background: linear-gradient(180deg, var(--morado-top) 0%, var(--morado) 100%);
    transition: transform .16s var(--ease), box-shadow .22s ease, background .22s ease;
  }
  .pd-form-submit:hover {
    background: linear-gradient(180deg, #38294C 0%, #2A1F38 100%);
    box-shadow: 0 12px 26px -14px rgba(36,26,46,.8);
