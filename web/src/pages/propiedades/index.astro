  /* Mapa: arriba de la rejilla en móvil; sticky a la derecha en desktop. */
  .cat-mapwrap {
    position: relative;
    height: clamp(320px, 46vh, 440px);
    order: -1;
  }
  .cat-map-inner {
    position: relative;
    height: 100%;
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--color-tinta) 10%, transparent);
    border-radius: 2px;
    overflow: hidden;
    background: #E9E6DF;
  }
  #gg-map { position: absolute; inset: 0; }

  /* Botón de pantalla completa (esquina sup. izq. del mapa). */
  .cat-map-expand {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 600;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: #fff;
    border: 0;
    border-radius: 2px;
    cursor: pointer;
    color: #14101C;
    box-shadow: 0 8px 24px -14px rgba(20, 16, 28, .5);
    transition: color .2s ease, transform .2s ease;
  }
  .cat-map-expand:hover { color: #B98F55; }
  .cat-map-expand:focus-visible { outline: 2px solid #B98F55; outline-offset: 2px; }
  .cat-map-ico-close { display: none; }
  .cat-mapwrap.is-fs .cat-map-ico-open { display: none; }
  .cat-mapwrap.is-fs .cat-map-ico-close { display: block; }

  /* Modo pantalla completa: el mapa ocupa todo el viewport. */
  .cat-mapwrap.is-fs {
    position: fixed !important;
    inset: 0 !important;
    top: 0 !important;
    height: 100dvh !important;
    width: 100vw !important;
    margin: 0;
    z-index: 1300;
  }
  .cat-mapwrap.is-fs .cat-map-inner { border-radius: 0; border: 0; }

  @media (min-width: 1080px) {
    .cat-split { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
    .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Mapa fijo (patrón "listado + mapa"): ocupa toda la altura del viewport bajo el
       navbar y se queda estático (sticky). Solo scrollea la columna de propiedades a la
       izquierda; con lista larga el mapa se mantiene anclado casi todo el recorrido.
       `align-self:start` evita que la celda lo estire y anule el pin. */
    .cat-mapwrap {
      order: 0;
      align-self: start;
      position: sticky;
      top: 88px;                       /* justo bajo el navbar sólido sticky */
      height: calc(100dvh - 108px);    /* alto del viewport menos navbar + respiro */
    }
  }

  @media (max-width: 559px) {
    .cat-filtros { gap: 10px; }
    .cat-op, .cat-search { flex: 1 1 100%; }
    .cat-selects { width: 100%; }
    .cat-field { flex: 1 1 calc(50% - 7px); }
    .cat-select { width: 100%; }
  }
</style>

<!-- Estilos globales para Leaflet (se generan en el DOM dinámicamente → no pueden ir en
     el <style> con scope de Astro). Tiles a color (leve pulido) + controles sobrios. -->
<style is:global>
  .leaflet-container { font-family: 'Montserrat Variable', 'Montserrat', sans-serif; background: #E9E6DF; }
  /* Mapa a color (OpenStreetMap estándar): realce suave para que los verdes de parques y
     del Ávila ganen presencia y aporten contraste, sin recargar las vías. */
  .leaflet-tile-pane { filter: saturate(1.12) contrast(.99) brightness(1.02); }
  .gg-pin { background: transparent !important; border: 0 !important; }
  .leaflet-control-zoom a {
    color: #14101C !important;
    border-color: rgba(20,16,28,.10) !important;
    background: #fff !important;
    font-weight: 400 !important;
  }
  .leaflet-bar { box-shadow: 0 8px 24px -14px rgba(20,16,28,.5) !important; border: 0 !important; }
  .leaflet-control-attribution { font-size: 10px; background: rgba(255,255,255,.7) !important; }

  /* ---- Pines: marcador tipo gota (tinta + núcleo dorado), minimalista y legible sobre
     el mapa a color. La punta apunta a la coordenada → el wrapper la ancla (translate).
     Estado activo (hover de tarjeta/pin o popup abierto): invierte a dorado y crece. ---- */
  .gg-pin-inner { transform: translate(-50%, -100%); }
  .gg-pin-dot {
    position: relative;
    display: block;
    width: 24px;
    height: 24px;
    background: #14101C;
    border: 2px solid #FCFBF8;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    box-shadow: 0 6px 16px -4px rgba(16, 14, 23, .55);
    transition: transform .16s cubic-bezier(.23, 1, .32, 1), background .16s ease, box-shadow .16s ease;
  }
  /* Núcleo dorado, centrado (la rotación de la gota es alrededor del centro). */
  .gg-pin-dot::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #C9A46A;
    transform: translate(-50%, -50%);
  }
  .gg-pin-inner.is-active { z-index: 1000; }
  .gg-pin-inner.is-active .gg-pin-dot {
    transform: rotate(-45deg) scale(1.18);
    background: #C9A46A;
    box-shadow: 0 12px 26px -6px rgba(16, 14, 23, .7);
  }
  .gg-pin-inner.is-active .gg-pin-dot::after { background: #14101C; }
  /* Movimiento reducido: conserva el cambio de color, quita el crecimiento. */
  @media (prefers-reduced-motion: reduce) {
    .gg-pin-dot { transition: background .16s ease, box-shadow .16s ease; }
    .gg-pin-inner.is-active .gg-pin-dot { transform: rotate(-45deg); }
  }

