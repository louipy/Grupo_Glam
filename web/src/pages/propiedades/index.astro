  /* ---- Split: rejilla + mapa ---- */
  .cat-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(26px, 3vw, 48px);
    align-items: start;
  }
  .cat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 2vw, 32px);
  }
  @media (min-width: 560px) {
