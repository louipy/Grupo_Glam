  }
  @media (min-width: 920px) and (max-width: 1079px) {
    .cat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .cat-empty {
    margin: clamp(24px, 4vw, 48px) 0 0;
    padding: clamp(20px, 3vw, 32px);
