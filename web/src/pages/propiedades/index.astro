  .cat-count {
    margin: 0;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-humo);
  }
  .cat-sort { display: flex; align-items: center; gap: 10px; }
  .cat-sort-lbl {
    font-weight: 600;
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--color-humo);
